<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CA1848;CA1716;CA1711;CA1724;CA1031;CA2007;CA1062;CA1303;CA1515;CA1819;CA2227;CA1002;CA1056;CA1054;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1812;CA1852;CA5394;CA1873;CA1720;CA1710;CA1814;CA1508;CA1513;CA1512;CA1859;CA1805;CA1822;CA1051;CA1034;CA1815;CA2225;CA1000;CA1036;CA1040;CA1063;CA1816;CA1033;CA2213;CA1001;CA1849;CA1835;CA1308;CA1806;CA1032;CA1064;CA2201;CA1725;CA1065;CA1814;CA1028;CA1008;CA1027;CA1508;CA1860;CA1862;CA1865;CA1866;CA1867;CA1869;CA1825;CA1847;CA1854;CA1851;CA1868;CA1872;CA2208;CA1823</NoWarn>
    <Version>1.4.0</Version>
    <Product>Sonda</Product>
    <Authors>Erik L. Pimenta</Authors>
    <Copyright>Copyright (c) 2026 Sonda</Copyright>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
