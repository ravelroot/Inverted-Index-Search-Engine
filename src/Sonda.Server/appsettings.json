{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://127.0.0.1:8080",
  "Sonda": {
    "IndexPath": "dados/indice",
    "DataPath": "dados",
    "Analysis": {
      "Language": "auto",
      "DefaultLanguage": "pt",
      "StopWords": true,
      "FoldAccents": true
    },
    "Indexing": {
      "RamBufferMb": 128,
      "Parallelism": 0,
      "MaxFileMb": 32,
      "StoreBody": true,
      "MergeFactor": 10,
      "AutoMerge": true,
      "IndexOnStartup": true,
      "WatchDebounceSeconds": 3
    },
    "Search": {
      "Similarity": "BM25",
      "K1": 1.2,
      "B": 0.75,
      "TitleBoost": 2.0,
      "DefaultOperator": "And",
      "MaxResultWindow": 1000,
      "SnippetLength": 240
    },
    "Api": {
      "ApiKey": "",
      "ProtectReads": false,
      "AllowedOrigins": []
    },
    "AllowedRoots": [],
    "Sources": [
      {
        "Name": "exemplos",
        "Path": "samples/corpus",
        "Include": [ "*.txt", "*.md", "*.html", "*.htm" ],
        "Watch": true
      }
    ]
  }
}
