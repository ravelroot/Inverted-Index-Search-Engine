  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sonda.Engine\Sonda.Engine.csproj" />
  </ItemGroup>
</Project>
